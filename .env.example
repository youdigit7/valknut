# ============================================================
# VALKNUT - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ============================================================

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Cloudinary Primary Media CDN ---
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_API_KEY=your-cloudinary-api-key
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# --- Firebase (Optional Analytics) ---
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_PROJECT_ID=your-project-id

# --- Payment Gateways (server-side only, set as Supabase Edge Function secrets) ---
# KOKO_API_KEY=
# KOKO_API_SECRET=
# ONEPAY_MERCHANT_ID=
# ONEPAY_API_KEY=
# EWAY_API_KEY=
# EWAY_API_PASSWORD=
# EWAY_ENCRYPTION_KEY=

# --- Email Service (server-side only) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@valknut.lk

# --- SMS Service (server-side only) ---
# SMS_API_KEY=
# SMS_SENDER_ID=VALKNUT

# --- App Config ---
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=VALKNUT
