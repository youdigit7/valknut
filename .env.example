# ============================================================
# VALKNUT - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ============================================================

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Firebase ---
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Payment Gateways (server-side only, set as Supabase Edge Function secrets) ---
# KOKO_API_KEY=
# KOKO_API_SECRET=
# ONEPAY_MERCHANT_ID=
# ONEPAY_API_KEY=
# EWAY_API_KEY=
# EWAY_API_PASSWORD=
# EWAY_ENCRYPTION_KEY=

# --- Email Service (server-side only) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@valknut.lk

# --- SMS Service (server-side only) ---
# SMS_API_KEY=
# SMS_SENDER_ID=VALKNUT

# --- App Config ---
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=VALKNUT
