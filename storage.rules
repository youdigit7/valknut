rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Product catalog, hero banners, and category assets (Public read, admin write)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.email.matches('.*@valknutofficial[.]com$') ||
        request.auth.token.email == 'admin@valknut.lk'
      );
    }
    
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.email.matches('.*@valknutofficial[.]com$') ||
        request.auth.token.email == 'admin@valknut.lk'
      );
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.email.matches('.*@valknutofficial[.]com$') ||
        request.auth.token.email == 'admin@valknut.lk'
      );
    }

    // 2. Custom Studio customer bespoke artwork uploads
    // Allows public read for order fulfillment/preview, validated upload up to 15MB
    match /custom-studio/{artworkId} {
      allow read: if true;
      allow create: if request.resource.size < 15 * 1024 * 1024
                    && (request.resource.contentType.matches('image/png')
                        || request.resource.contentType.matches('image/jpeg')
                        || request.resource.contentType.matches('image/webp')
                        || request.resource.contentType.matches('image/svg\\+xml'));
      allow delete: if request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.email.matches('.*@valknutofficial[.]com$')
      );
    }
  }
}
